# Copy to .env and fill in. Used only by the server (server/), never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail (optional; without it the inbox shows demo emails). See README → "Connecting Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/callback

# Daily automatic scan of new Gmail messages ("off" to disable)
# SCAN_TIME=08:00
# SCAN_TIMEZONE=Asia/Jerusalem

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# GMAIL_QUERY=newer_than:60d (invoice OR receipt OR חשבונית OR קבלה)
# GMAIL_MAX_RESULTS=25
# PORT=8787
# DATA_DIR=.data
